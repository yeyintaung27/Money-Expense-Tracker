# Copy this file to `.env` and fill in the values. `.env` is git-ignored —
# never commit real secrets.

# ---- Google Sheets ----
SHEET_ID=
# Local only: path to the service-account key file
CREDENTIALS_PATH=./credentials.json
# Production (Render): paste the ENTIRE contents of credentials.json here
# instead of uploading the file. Leave empty when running locally.
GOOGLE_CREDENTIALS=

# ---- Server ----
PORT=3001
# Long random hex string used to sign the 30-day session tokens
AUTH_SECRET=

# ---- Google OAuth (Web application Client ID) ----
GOOGLE_CLIENT_ID=

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend (Vite: these are read at BUILD time, prefix must be VITE_) ----
VITE_GOOGLE_CLIENT_ID=
# Leave empty locally (the dev proxy forwards /api to :3001).
# In production set it to your backend URL, e.g. https://your-app.onrender.com
VITE_API_BASE=
